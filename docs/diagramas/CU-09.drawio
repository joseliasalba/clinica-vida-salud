              <mxPoint x="440" y="150" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="CU09_2_note" value="Cita y auditoría se guardan en la misma transacción. Solo se actualizan estado=cancelada y motivo_cancelacion. El registro no se elimina. La exclusión PostgreSQL permite reutilizar el intervalo cancelado. La apertura de un estado no cancelable devuelve 409." style="shape=note;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;spacing=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="100" y="840" width="1370" height="150" as="geometry" />

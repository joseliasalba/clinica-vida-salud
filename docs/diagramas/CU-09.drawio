        <mxCell id="CU09_1_rules" value="Precondiciones: sesión y permiso citas.gestionar.&#10;Solo citas programadas o confirmadas.&#10;Motivo obligatorio, hasta 255 caracteres.&#10;Confirmación explícita y versión vigente.&#10;La cita conserva sus relaciones y fechas; el intervalo queda disponible." style="shape=note;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;spacing=12;align=left;" vertex="1" parent="1">

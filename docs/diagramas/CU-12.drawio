        <mxCell id="CU12_2_note" value="Solo SELECT. El paciente no puede seleccionar otra ficha por parámetro ni por ruta. El personal puede consultar fichas activas e inactivas. Se presenta código, inicio/fin, estado, médico, especialidad y fecha de registro, sin modificar citas." style="shape=note;whiteSpace=wrap;html=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;spacing=12;align=left;" vertex="1" parent="1">

<mxfile host="app.diagrams.net" type="device"><diagram name="01 Caso de uso"><mxGraphModel dx="1200" dy="850" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="850"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="frame" value="uc CU-05 · Gestionar médicos y especialidades — Especialidades" style="shape=swimlane;startSize=40;fillColor=none;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="260" y="60" width="840" height="650" as="geometry"/></mxCell><mxCell id="actor" value="Administrador" style="shape=umlActor;fillColor=#ffe6cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="70" y="300" width="100" height="140" as="geometry"/></mxCell><mxCell id="cu" value="Gestionar especialidades médicas" style="ellipse;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="430" y="290" width="280" height="130" as="geometry"/></mxCell><mxCell id="a" value="" style="endArrow=none;" edge="1" parent="1" source="actor" target="cu"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Operaciones de CU-05:
• Listar, buscar y filtrar; paginar
• Registrar nombre y descripción
• Editar datos
• Confirmar activación/desactivación

Requiere sesión y permiso efectivo.
Los rechazos conservan los datos guardados." style="shape=note;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="770" y="190" width="260" height="340" as="geometry"/></mxCell></root></mxGraphModel></diagram>

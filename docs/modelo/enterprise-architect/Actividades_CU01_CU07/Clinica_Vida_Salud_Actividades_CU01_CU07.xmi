			<element xmi:idref="EAID_097DEF37_3429_4345_AC5A_9DEB12762ED0" xmi:type="uml:Note" scope="public">
				<model package="EAPK_528B0023_270F_43be_9068_D4F3969EDE08" tpos="0" ea_localid="109" ea_eleType="element"/>
				<properties documentation="Sesión vigente y medicos.gestionar efectivo.&#xA;&#xA;Médicos: especialidades activas obligatorias; cuenta existente opcional y elegible. Reactivar exige especialidad activa. El estado tiene confirmación separada. Especialidades: nombre único normalizado. Conservar vínculos, horarios y citas. No crear cuentas automáticamente ni modificar roles." isSpecification="false" sType="Note" nType="0" scope="public"/>
				<project author="llx21" version="1.0" phase="1.0" created="2026-10-24 20:03:38" modified="2026-10-24 20:03:38" complexity="1" status="Proposed"/>
				<code gentype="&lt;none&gt;"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>
				<xrefs/>
				<extendedProperties tagged="0" package_name="CU-05 Gestionar médicos y especialidades"/>
			</element>
			<element xmi:idref="EAPK_17467F62_C9E2_4e0c_819A_3EAAC52035AB" xmi:type="uml:Package" name="CU-06 Configurar horarios de atención y bloqueos" scope="public">
				<model package2="EAID_17467F62_C9E2_4e0c_819A_3EAAC52035AB" package="EAPK_0AB9757A_0D7B_4c28_B64D_FE09A364DB53" tpos="0" ea_localid="8" ea_eleType="package"/>
				<properties documentation="Sesión vigente y horarios.gestionar efectivo.&#xA;Franja semanal y vigencia deben producir turnos completos; duración divide la franja. Los bloqueos restan disponibilidad. No solapar registros activos del mismo tipo. No dejar citas pendientes sin cobertura ni bloquearlas. Toda mutación bloquea primero al médico. CU-06 no cancela ni reprograma citas." isSpecification="false" sType="Package" nType="0" scope="public"/>
				<project author="llx21" phase="1.0" created="2026-10-24 20:03:36" modified="2026-10-24 20:03:36" complexity="1" status="Proposed"/>
				<code gentype="Java"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>

				<tags/>
				<xrefs/>
				<extendedProperties tagged="0" package_name="CU-04 Registrar y gestionar pacientes en recepción"/>
			</element>
			<element xmi:idref="EAPK_528B0023_270F_43be_9068_D4F3969EDE08" xmi:type="uml:Package" name="CU-05 Gestionar médicos y especialidades" scope="public">
				<model package2="EAID_528B0023_270F_43be_9068_D4F3969EDE08" package="EAPK_0AB9757A_0D7B_4c28_B64D_FE09A364DB53" tpos="0" ea_localid="7" ea_eleType="package"/>
				<properties documentation="Sesión vigente y medicos.gestionar efectivo.&#xA;Médicos: especialidades activas obligatorias; cuenta existente opcional y elegible. Reactivar exige especialidad activa. El estado tiene confirmación separada. Especialidades: nombre único normalizado. Conservar vínculos, horarios y citas. No crear cuentas automáticamente ni modificar roles." isSpecification="false" sType="Package" nType="0" scope="public"/>
				<project author="llx21" phase="1.0" created="2026-10-24 20:03:36" modified="2026-10-24 20:03:36" complexity="1" status="Proposed"/>

			<element xmi:idref="EAID_0727BE40_64E3_4ae7_B78F_452DB78A1FAA" xmi:type="uml:Note" scope="public">
				<model package="EAPK_17467F62_C9E2_4e0c_819A_3EAAC52035AB" tpos="0" ea_localid="129" ea_eleType="element"/>
				<properties documentation="Sesión vigente y horarios.gestionar efectivo.&#xA;&#xA;Franja semanal y vigencia deben producir turnos completos; duración divide la franja. Los bloqueos restan disponibilidad. No solapar registros activos del mismo tipo. No dejar citas pendientes sin cobertura ni bloquearlas. Toda mutación bloquea primero al médico. CU-06 no cancela ni reprograma citas." isSpecification="false" sType="Note" nType="0" scope="public"/>
				<project author="llx21" version="1.0" phase="1.0" created="2026-10-24 20:03:38" modified="2026-10-24 20:03:38" complexity="1" status="Proposed"/>
				<code gentype="&lt;none&gt;"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>
				<xrefs/>
				<extendedProperties tagged="0" package_name="CU-06 Configurar horarios de atención y bloqueos"/>
			</element>
			<element xmi:idref="EAPK_66282449_0C03_4008_8F5E_F0D664D2D618" xmi:type="uml:Package" name="CU-07 Consultar disponibilidad y reservar cita" scope="public">
				<model package2="EAID_66282449_0C03_4008_8F5E_F0D664D2D618" package="EAPK_0AB9757A_0D7B_4c28_B64D_FE09A364DB53" tpos="0" ea_localid="9" ea_eleType="package"/>
				<properties documentation="Paciente: citas.propias, ficha propia activa y correo verificado. Personal: citas.gestionar y paciente activo elegido.&#xA;El paciente no elige otra identidad. El personal autorizado puede seleccionar paciente sin exigir que tenga cuenta o correo verificado. Consulta hasta 30 días. Revisar no retiene turno. Token cifrado ligado al actor, 30 min. Cita programada y auditoría son atómicas; el comprobante requiere titularidad o permiso de gestión." isSpecification="false" sType="Package" nType="0" scope="public"/>
				<project author="llx21" phase="1.0" created="2026-10-24 20:03:37" modified="2026-10-24 20:03:37" complexity="1" status="Proposed"/>
				<code gentype="Java"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>

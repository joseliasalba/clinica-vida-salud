<?xml version="1.0" encoding="windows-1252"?>
<xmi:XMI xmi:version="2.1" xmlns:uml="http://schema.omg.org/spec/UML/2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1">
	<xmi:Documentation exporter="Enterprise Architect" exporterVersion="6.5"/>
	<uml:Model xmi:type="uml:Model" name="EA_Model" visibility="public">
		<packagedElement xmi:type="uml:Package" xmi:id="EAPK_0AB9757A_0D7B_4c28_B64D_FE09A364DB53" name="Clínica Vida Salud - Actividades CU-01 a CU-07 y actores" visibility="public">
			<packagedElement xmi:type="uml:Package" xmi:id="EAPK_6CF22BDB_BCC9_4865_BD05_5FA976EFF3A7" name="ACTORES Actores y límites de acceso" visibility="public">
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_C79D44D1_A0A7_46d4_B6BF_26D7EDC8CF81" body="&lt;p&gt;&lt;b&gt;Responsabilidad:&lt;/b&gt; Acceder a su cuenta, verificar correo y reservar para su ficha vinculada&lt;/p&gt;&lt;p&gt;&lt;b&gt;Límite de acceso:&lt;/b&gt; No puede escoger la identidad de otro paciente ni consultar comprobantes ajenos&lt;/p&gt;">
					<annotatedElement xmi:idref="EAID_C7F4EE92_CDD5_4d86_A9F6_9DF7339B627C"/>
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_9358BB89_4449_4660_9046_B0EFD5ED072D" body="&lt;p&gt;&lt;b&gt;Responsabilidad:&lt;/b&gt; Identificar pacientes y registrar o gestionar citas de acuerdo con su autorización&lt;/p&gt;&lt;p&gt;&lt;b&gt;Límite de acceso:&lt;/b&gt; No configura médicos ni horarios con el conjunto inicial de permisos&lt;/p&gt;">
					<annotatedElement xmi:idref="EAID_3E37AF51_AE19_4021_B333_4D82A1CA24C2"/>
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_46EFE2F8_7262_49be_A7C4_06611147AA8F" body="&lt;p&gt;&lt;b&gt;Responsabilidad:&lt;/b&gt; Configurar usuarios, médicos, especialidades y horarios; supervisar operaciones autorizadas&lt;/p&gt;&lt;p&gt;&lt;b&gt;Límite de acceso:&lt;/b&gt; Actúa según permisos efectivos; no se presume acceso irrestricto a datos clínicos&lt;/p&gt;">
					<annotatedElement xmi:idref="EAID_B3F3AE54_1BF6_4de1_B095_C41C5E527750"/>
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_0F1F25A5_7C9B_4dad_8E59_27A7D9367135" body="&lt;p&gt;&lt;b&gt;Responsabilidad:&lt;/b&gt; Consultar su agenda y los datos básicos necesarios para atender&lt;/p&gt;&lt;p&gt;&lt;b&gt;Límite de acceso:&lt;/b&gt; CU-11 se limitará al profesional vinculado y requerirá una política explícita para consultas administrativas&lt;/p&gt;">
					<annotatedElement xmi:idref="EAID_4D6416CD_785C_415e_B7AB_87D090261273"/>
				</ownedComment>
				<packagedElement xmi:type="uml:Actor" xmi:id="EAID_B3F3AE54_1BF6_4de1_B095_C41C5E527750" name="Administrador" visibility="public"/>
				<packagedElement xmi:type="uml:Actor" xmi:id="EAID_4D6416CD_785C_415e_B7AB_87D090261273" name="Médico" visibility="public"/>
				<packagedElement xmi:type="uml:Actor" xmi:id="EAID_C7F4EE92_CDD5_4d86_A9F6_9DF7339B627C" name="Paciente" visibility="public"/>
				<packagedElement xmi:type="uml:Actor" xmi:id="EAID_3E37AF51_AE19_4021_B333_4D82A1CA24C2" name="Recepcionista" visibility="public"/>
			</packagedElement>
			<packagedElement xmi:type="uml:Package" xmi:id="EAPK_782497FD_5B9D_46a3_BA9D_5D62B9820775" name="CU-01 Iniciar y cerrar sesión" visibility="public">
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_35BA53B4_975A_43fc_A259_0A638F501EC0" body="Acceso para invitados; funciones internas según sesión vigente y permisos efectivos.&#xA;&#xA;Límites: 5 fallos por identificador/IP, espera 15 min y límite adicional por IP. Inactividad: 30 min. Credenciales inexistentes, inactivas e incorrectas reciben mensaje genérico. El acceso normal va a /inicio; booking.continue permite continuar en /citas. Recuperación corresponde a CU-01.1."/>

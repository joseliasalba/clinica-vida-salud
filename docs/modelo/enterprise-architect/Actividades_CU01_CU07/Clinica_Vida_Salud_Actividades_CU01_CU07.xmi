			<packagedElement xmi:type="uml:Package" xmi:id="EAPK_E8E74320_5384_42a0_B2D9_31F36FE53C44" name="CU-02 Administrar usuarios, roles y permisos" visibility="public">
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_687919DF_49DB_4002_AD2E_2961495B90B2" body="Sesión vigente y usuarios.gestionar efectivo.&#xA;&#xA;Sin sesión: login; sin permiso: 403. Usuarios y roles se crean/editan; permisos solo cambian de estado dentro del catálogo. No hay borrado físico. Se preservan vínculos inactivos. Datos de contraseña nunca se repueblan. No se crean fichas clínicas ni se envía correo al crear cuentas."/>
				<packagedElement xmi:type="uml:Activity" xmi:id="EAID_AC000002_5384_42a0_B2D9_31F36FE53C44" name="EA_Activity2" visibility="public">

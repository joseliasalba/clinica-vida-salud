			<element xmi:idref="EAID_0CBFCA82_6E8D_477b_9BD7_69FFFA1BF04D" xmi:type="uml:Note" scope="public">
				<model package="EAPK_64041FFE_DABB_4223_BBDA_68BE928B33FF" tpos="0" ea_localid="73" ea_eleType="element"/>
				<properties documentation="Registro público. Verificación: cuenta autenticada y enlace firmado de la misma cuenta.&#xA;&#xA;Cuenta y ficha se crean juntas, con rol paciente activo. No se vinculan fichas previas por coincidencia. Un fallo de correo no revierte el registro. El reenvío exige sesión y espera de 60 s. Verificar correo no reserva una cita. En modo log/array no se entrega a la bandeja." isSpecification="false" sType="Note" nType="0" scope="public"/>
				<project author="llx21" version="1.0" phase="1.0" created="2026-10-24 20:03:38" modified="2026-10-24 20:03:38" complexity="1" status="Proposed"/>
				<code gentype="&lt;none&gt;"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>
				<xrefs/>
				<extendedProperties tagged="0" package_name="CU-03 Registrarse como paciente"/>
			</element>
			<element xmi:idref="EAPK_6E9562BE_EC3B_4eb6_88E6_CFADAC0532E6" xmi:type="uml:Package" name="CU-04 Registrar y gestionar pacientes en recepción" scope="public">
				<model package2="EAID_6E9562BE_EC3B_4eb6_88E6_CFADAC0532E6" package="EAPK_0AB9757A_0D7B_4c28_B64D_FE09A364DB53" tpos="0" ea_localid="6" ea_eleType="package"/>
				<properties documentation="Sesión vigente y pacientes.gestionar efectivo.&#xA;Consultar una ficha no la modifica. Estado se cambia dentro de edición. CI opcional, normalizado y único incluso entre inactivos. En edición se bloquea ficha y comprueba HMAC de versión. No borrar físicamente ni crear automáticamente cuenta o historia clínica." isSpecification="false" sType="Package" nType="0" scope="public"/>
				<project author="llx21" phase="1.0" created="2026-10-24 20:03:35" modified="2026-10-24 20:03:36" complexity="1" status="Proposed"/>
				<code gentype="Java"/>

			<element xmi:idref="EAID_687919DF_49DB_4002_AD2E_2961495B90B2" xmi:type="uml:Note" scope="public">
				<model package="EAPK_E8E74320_5384_42a0_B2D9_31F36FE53C44" tpos="0" ea_localid="55" ea_eleType="element"/>
				<properties documentation="Sesión vigente y usuarios.gestionar efectivo.&#xA;&#xA;Sin sesión: login; sin permiso: 403. Usuarios y roles se crean/editan; permisos solo cambian de estado dentro del catálogo. No hay borrado físico. Se preservan vínculos inactivos. Datos de contraseña nunca se repueblan. No se crean fichas clínicas ni se envía correo al crear cuentas." isSpecification="false" sType="Note" nType="0" scope="public"/>
				<project author="llx21" version="1.0" phase="1.0" created="2026-10-24 20:03:38" modified="2026-10-24 20:03:38" complexity="1" status="Proposed"/>
				<code gentype="&lt;none&gt;"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>
				<xrefs/>
				<extendedProperties tagged="0" package_name="CU-02 Administrar usuarios, roles y permisos"/>
			</element>
			<element xmi:idref="EAPK_64041FFE_DABB_4223_BBDA_68BE928B33FF" xmi:type="uml:Package" name="CU-03 Registrarse como paciente" scope="public">
				<model package2="EAID_64041FFE_DABB_4223_BBDA_68BE928B33FF" package="EAPK_0AB9757A_0D7B_4c28_B64D_FE09A364DB53" tpos="0" ea_localid="5" ea_eleType="package"/>
				<properties documentation="Registro público. Verificación: cuenta autenticada y enlace firmado de la misma cuenta.&#xA;Cuenta y ficha se crean juntas, con rol paciente activo. No se vinculan fichas previas por coincidencia. Un fallo de correo no revierte el registro. El reenvío exige sesión y espera de 60 s. Verificar correo no reserva una cita. En modo log/array no se entrega a la bandeja." isSpecification="false" sType="Package" nType="0" scope="public"/>
				<project author="llx21" phase="1.0" created="2026-10-24 20:03:35" modified="2026-10-24 20:03:35" complexity="1" status="Proposed"/>
				<code gentype="Java"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>
				<xrefs/>
				<extendedProperties tagged="0" package_name="Clínica Vida Salud - Actividades CU-01 a CU-07 y actores"/>
				<packageproperties tpos="0"/>
				<paths/>
				<times created="2026-10-24 20:03:35" modified="2026-10-24 20:03:35"/>
				<flags iscontrolled="FALSE" isprotected="FALSE" batchsave="0" batchload="0" usedtd="FALSE" logxml="FALSE"/>
			</element>

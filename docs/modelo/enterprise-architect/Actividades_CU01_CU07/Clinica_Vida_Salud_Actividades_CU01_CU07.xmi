			<element xmi:idref="EAID_1F093C5D_353F_4e1c_9D9F_053F202EC44C" xmi:type="uml:Note" scope="public">
				<model package="EAPK_6E9562BE_EC3B_4eb6_88E6_CFADAC0532E6" tpos="0" ea_localid="91" ea_eleType="element"/>
				<properties documentation="Sesión vigente y pacientes.gestionar efectivo.&#xA;&#xA;Consultar una ficha no la modifica. Estado se cambia dentro de edición. CI opcional, normalizado y único incluso entre inactivos. En edición se bloquea ficha y comprueba HMAC de versión. No borrar físicamente ni crear automáticamente cuenta o historia clínica." isSpecification="false" sType="Note" nType="0" scope="public"/>
				<project author="llx21" version="1.0" phase="1.0" created="2026-10-24 20:03:38" modified="2026-10-24 20:03:38" complexity="1" status="Proposed"/>
				<code gentype="&lt;none&gt;"/>

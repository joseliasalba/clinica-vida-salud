			<element xmi:idref="EAID_DD82023F_C0AE_44a4_B6C4_CD108E6290CE" xmi:type="uml:Note" scope="public">
				<model package="EAPK_66282449_0C03_4008_8F5E_F0D664D2D618" tpos="0" ea_localid="153" ea_eleType="element"/>
				<properties documentation="Paciente: citas.propias, ficha propia activa y correo verificado. Personal: citas.gestionar y paciente activo elegido.&#xA;&#xA;El paciente no elige otra identidad. El personal autorizado puede seleccionar paciente sin exigir que tenga cuenta o correo verificado. Consulta hasta 30 días. Revisar no retiene turno. Token cifrado ligado al actor, 30 min. Cita programada y auditoría son atómicas; el comprobante requiere titularidad o permiso de gestión." isSpecification="false" sType="Note" nType="0" scope="public"/>
				<project author="llx21" version="1.0" phase="1.0" created="2026-10-24 20:03:38" modified="2026-10-24 20:03:38" complexity="1" status="Proposed"/>

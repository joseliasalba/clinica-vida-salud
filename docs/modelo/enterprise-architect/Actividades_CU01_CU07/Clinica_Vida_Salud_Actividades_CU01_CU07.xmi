			<element xmi:idref="EAID_35BA53B4_975A_43fc_A259_0A638F501EC0" xmi:type="uml:Note" scope="public">
				<model package="EAPK_782497FD_5B9D_46a3_BA9D_5D62B9820775" tpos="0" ea_localid="30" ea_eleType="element"/>
				<properties documentation="Acceso para invitados; funciones internas según sesión vigente y permisos efectivos.&#xA;&#xA;Límites: 5 fallos por identificador/IP, espera 15 min y límite adicional por IP. Inactividad: 30 min. Credenciales inexistentes, inactivas e incorrectas reciben mensaje genérico. El acceso normal va a /inicio; booking.continue permite continuar en /citas. Recuperación corresponde a CU-01.1." isSpecification="false" sType="Note" nType="0" scope="public"/>
				<project author="llx21" version="1.0" phase="1.0" created="2026-10-24 20:03:37" modified="2026-10-24 20:03:37" complexity="1" status="Proposed"/>
				<code gentype="&lt;none&gt;"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>
				<xrefs/>
				<extendedProperties tagged="0" package_name="CU-01 Iniciar y cerrar sesión"/>
			</element>
			<element xmi:idref="EAPK_E8E74320_5384_42a0_B2D9_31F36FE53C44" xmi:type="uml:Package" name="CU-02 Administrar usuarios, roles y permisos" scope="public">
				<model package2="EAID_E8E74320_5384_42a0_B2D9_31F36FE53C44" package="EAPK_0AB9757A_0D7B_4c28_B64D_FE09A364DB53" tpos="0" ea_localid="4" ea_eleType="package"/>
				<properties documentation="Sesión vigente y usuarios.gestionar efectivo.&#xA;Sin sesión: login; sin permiso: 403. Usuarios y roles se crean/editan; permisos solo cambian de estado dentro del catálogo. No hay borrado físico. Se preservan vínculos inactivos. Datos de contraseña nunca se repueblan. No se crean fichas clínicas ni se envía correo al crear cuentas." isSpecification="false" sType="Package" nType="0" scope="public"/>
				<project author="llx21" phase="1.0" created="2026-10-24 20:03:35" modified="2026-10-24 20:03:35" complexity="1" status="Proposed"/>
				<code gentype="Java"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>
				<xrefs/>

<?xml version="1.0" encoding="windows-1252"?>
<xmi:XMI xmi:version="2.1" xmlns:uml="http://schema.omg.org/spec/UML/2.1" xmlns:xmi="http://schema.omg.org/spec/XMI/2.1" xmlns:thecustomprofile="http://www.sparxsystems.com/profiles/thecustomprofile/1.0" xmlns:EAUML="http://www.sparxsystems.com/profiles/EAUML/1.0">
	<xmi:Documentation exporter="Enterprise Architect" exporterVersion="6.5"/>
	<uml:Model xmi:type="uml:Model" name="EA_Model" visibility="public">
		<packagedElement xmi:type="uml:Package" xmi:id="EAPK_53EBB3E2_334A_4315_9C34_49CF341B6D51" name="Clínica Vida Salud - CU-01 y CU-02" visibility="public">
			<packagedElement xmi:type="uml:Package" xmi:id="EAPK_2A245BC7_4898_49d5_8C04_C7ED37D49130" name="00 Elementos compartidos" visibility="public">
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_FEE9728C_8317_4746_92FA_920AC45C4918" body="Recepción, médico y paciente acceden a las funciones de sus permisos vigentes."/>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_F71CEC64_CCCC_46cc_A294_D564830BA748" body="CU-02 requiere una sesión válida y permiso efectivo. Es precondición, no un include que repita el login en cada operación.">
					<annotatedElement xmi:idref="EAID_D129B3F4_DA83_45cd_925A_330577504E4F"/>
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_A6B460CD_7D1D_431e_A572_5B368D2EB544" body="Despliegue local comprobado. SMTP real pendiente de configurar. No se incluyen credenciales ni un servidor de producción ficticio."/>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_927CBDFC_2AB6_416d_BB25_3ECD4EDF31F3" body="Rol inicial con el permiso usuarios.gestionar. Administra cuentas, roles y permisos.">
					<annotatedElement xmi:idref="EAID_2FC1DD87_040F_4daf_9F8D_B001AC0F1368"/>
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_78CAC06F_9045_4593_893F_9D3FCDBCA691" body="Agrupa CU-01, CU-01.1 y CU-02. Contiene las funciones de acceso y de administración implementadas.">
					<annotatedElement xmi:idref="EAPK_48F73CBA_A9A7_4178_AEEE_E096BC612C3F"/>
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_59921D10_1286_440b_91CB_EE37B365FBD5" body="Escala en minutos. El tramo 0–2 es esquemático, no una medición de rendimiento. Se invalida al alcanzar 30 min sin actividad desde el último acceso."/>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_4BE405AC_EAD6_4272_AF18_E5FE2CEC7674" body="Actor de CU-02: cualquier cuenta activa con usuarios.gestionar efectivo.">
					<annotatedElement xmi:idref="EAID_EDF33F3D_D435_40c4_B258_834B874FB563"/>
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_134651D7_C1E1_4a3b_AA8F_ED5840095272" body="Persona con una cuenta activa. Puede ingresar y cerrar su sesión.">
					<annotatedElement xmi:idref="EAID_A6B99830_4C69_4ee5_9850_D1DAACA0644A"/>
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_12E1BE9A_05AE_4a26_8ECC_88CB203E45F7" body="Escala ordinal t0–t3, sin duración de rendimiento prometida. En la alternativa insegura, t3 es Revertida (ROLLBACK), no Confirmada."/>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_0B54B6E6_39F7_43aa_994C_C54313EAAC7A" body="Sesiones, caché de intentos, hash Argon2id, validación, CSRF y cola de correo.">
					<annotatedElement xmi:idref="EAPK_EA17A87E_CE63_4c11_AF17_8618CF95A4CD"/>
				</ownedComment>

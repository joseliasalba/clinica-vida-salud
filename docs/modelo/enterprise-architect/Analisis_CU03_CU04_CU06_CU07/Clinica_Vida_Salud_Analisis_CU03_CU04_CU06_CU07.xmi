			<element xmi:idref="EAID_07D84087_E236_471d_AD38_D434A8D020D3" xmi:type="uml:Note" scope="public">
				<model package="EAPK_BB8F66C3_F637_467c_BE35_95E99AB37359" tpos="0" ea_localid="16" ea_eleType="element"/>
				<properties documentation="Realización: PacienteController + PatientRegistration; entidad: Paciente. La versión de edición es un HMAC calculado, no otra columna. Alta y edición son transaccionales; edición bloquea ficha y comprueba versión. CI normalizado único incluso entre inactivos. Cambiar estado conserva código, cuenta e historial. No hay borrado físico ni creación de historia clínica." isSpecification="false" sType="Note" nType="0" alias="cu04-nota" scope="public"/>
				<project author="llx21" version="1.0" phase="1.0" created="2026-10-24 19:53:06" modified="2026-10-24 19:53:06" complexity="1" status="Proposed"/>
				<code gentype="&lt;none&gt;"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>
				<xrefs/>
				<extendedProperties tagged="0" package_name="CU-04 Registrar y gestionar pacientes en recepción"/>
			</element>
			<element xmi:idref="EAPK_861B5312_3C96_4816_AE8F_B83CC31FD39E" xmi:type="uml:Package" name="CU-06 Configurar horarios de atención y bloqueos" scope="public">
				<model package2="EAID_861B5312_3C96_4816_AE8F_B83CC31FD39E" package="EAPK_63ADD16C_08C6_44f5_9AFD_845E65392280" tpos="0" ea_localid="5" ea_eleType="package"/>
				<properties documentation="Sesión vigente y permiso efectivo horarios.gestionar.&#xA;Realización: HorarioController e IndisponibilidadController + ScheduleManagement. Médico, HorarioAtencion, IndisponibilidadMedico y CitaMedica son entidades existentes. Franja, vigencia y periodo resumen sus campos temporales; no son columnas nuevas. Las operaciones expresan responsabilidades de análisis, realizadas también por servicios. Bloquear primero médico; validar versión, cruces y cobertura de citas. CU-06 no cancela ni reprograma." isSpecification="false" sType="Package" nType="0" scope="public"/>
				<project author="llx21" phase="1.0" created="2026-10-24 19:53:01" modified="2026-10-24 19:53:01" complexity="1" status="Proposed"/>
				<code gentype="Java"/>

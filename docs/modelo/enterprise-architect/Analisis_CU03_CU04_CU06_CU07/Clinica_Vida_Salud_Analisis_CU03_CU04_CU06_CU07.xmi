			<packagedElement xmi:type="uml:Package" xmi:id="EAPK_2DAA111C_D9F6_4c71_9E11_5D620F991A3B" name="CU-07 Consultar disponibilidad y reservar cita" visibility="public">
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_8D8DD2B5_3CC4_4d03_882C_93D8D26FF414" body="Realización del control: CitaController + AppointmentAvailability + AppointmentBooking. Agenda médica agrupa Medico, Especialidad, HorarioAtencion, IndisponibilidadMedico y citas: concepto de análisis, no un modelo Eloquent nuevo. Registro de cambio representa cambios_cita (Query Builder). Revisar no aparta turno. Token cifrado ligado al actor, 30 min; reserva bloquea médico y paciente, revalida y guarda cita programada + auditoría de forma atómica. Reintento devuelve la misma cita. Comprobante solo para titular o gestor."/>
				<packagedElement xmi:type="uml:Actor" xmi:id="EAID_5CA2063D_F23D_45c9_8754_975BECAA1E11" name="Paciente / Recepción autorizada" visibility="public"/>

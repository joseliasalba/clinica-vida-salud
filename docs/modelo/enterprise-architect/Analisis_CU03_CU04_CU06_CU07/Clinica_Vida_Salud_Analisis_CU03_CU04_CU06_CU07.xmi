			<element xmi:idref="EAID_8D8DD2B5_3CC4_4d03_882C_93D8D26FF414" xmi:type="uml:Note" scope="public">
				<model package="EAPK_2DAA111C_D9F6_4c71_9E11_5D620F991A3B" tpos="0" ea_localid="32" ea_eleType="element"/>
				<properties documentation="Realización del control: CitaController + AppointmentAvailability + AppointmentBooking. Agenda médica agrupa Medico, Especialidad, HorarioAtencion, IndisponibilidadMedico y citas: concepto de análisis, no un modelo Eloquent nuevo. Registro de cambio representa cambios_cita (Query Builder). Revisar no aparta turno. Token cifrado ligado al actor, 30 min; reserva bloquea médico y paciente, revalida y guarda cita programada + auditoría de forma atómica. Reintento devuelve la misma cita. Comprobante solo para titular o gestor." isSpecification="false" sType="Note" nType="0" alias="cu07-nota" scope="public"/>
				<project author="llx21" version="1.0" phase="1.0" created="2026-10-24 19:53:11" modified="2026-10-24 19:53:11" complexity="1" status="Proposed"/>
				<code gentype="&lt;none&gt;"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>
				<xrefs/>
				<extendedProperties tagged="0" package_name="CU-07 Consultar disponibilidad y reservar cita"/>
			</element>

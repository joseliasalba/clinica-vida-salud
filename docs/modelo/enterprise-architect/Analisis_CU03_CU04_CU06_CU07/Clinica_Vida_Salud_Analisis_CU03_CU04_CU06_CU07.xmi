			<element xmi:idref="EAID_C620E8B2_A577_4463_A2BC_9EFFBE0A2823" xmi:type="uml:Note" scope="public">
				<model package="EAPK_861B5312_3C96_4816_AE8F_B83CC31FD39E" tpos="0" ea_localid="24" ea_eleType="element"/>
				<properties documentation="Realización: HorarioController e IndisponibilidadController + ScheduleManagement. Médico, HorarioAtencion, IndisponibilidadMedico y CitaMedica son entidades existentes. Franja, vigencia y periodo resumen sus campos temporales; no son columnas nuevas. Las operaciones expresan responsabilidades de análisis, realizadas también por servicios. Bloquear primero médico; validar versión, cruces y cobertura de citas. CU-06 no cancela ni reprograma." isSpecification="false" sType="Note" nType="0" alias="cu06-nota" scope="public"/>
				<project author="llx21" version="1.0" phase="1.0" created="2026-10-24 19:53:09" modified="2026-10-24 19:53:09" complexity="1" status="Proposed"/>
				<code gentype="&lt;none&gt;"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>
				<xrefs/>
				<extendedProperties tagged="0" package_name="CU-06 Configurar horarios de atención y bloqueos"/>
			</element>
			<element xmi:idref="EAPK_2DAA111C_D9F6_4c71_9E11_5D620F991A3B" xmi:type="uml:Package" name="CU-07 Consultar disponibilidad y reservar cita" scope="public">
				<model package2="EAID_2DAA111C_D9F6_4c71_9E11_5D620F991A3B" package="EAPK_63ADD16C_08C6_44f5_9AFD_845E65392280" tpos="0" ea_localid="6" ea_eleType="package"/>
				<properties documentation="citas.propias: ficha propia activa y correo verificado. citas.gestionar: paciente activo seleccionado.&#xA;Realización del control: CitaController + AppointmentAvailability + AppointmentBooking. Agenda médica agrupa Medico, Especialidad, HorarioAtencion, IndisponibilidadMedico y citas: concepto de análisis, no un modelo Eloquent nuevo. Registro de cambio representa cambios_cita (Query Builder). Revisar no aparta turno. Token cifrado ligado al actor, 30 min; reserva bloquea médico y paciente, revalida y guarda cita programada + auditoría de forma atómica. Reintento devuelve la misma cita. Comprobante solo para titular o gestor." isSpecification="false" sType="Package" nType="0" scope="public"/>
				<project author="llx21" phase="1.0" created="2026-10-24 19:53:02" modified="2026-10-24 19:53:02" complexity="1" status="Proposed"/>
				<code gentype="Java"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>
				<xrefs/>
				<extendedProperties tagged="0" package_name="Clínica Vida Salud - Clases de análisis CU-03 CU-04 CU-06 CU-07"/>

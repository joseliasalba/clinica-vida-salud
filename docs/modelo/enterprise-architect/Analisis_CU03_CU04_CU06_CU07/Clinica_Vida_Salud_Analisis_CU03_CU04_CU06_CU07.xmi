			<element xmi:idref="EAID_D6A3CD7D_7443_4e16_BA6D_6766967D95CD" xmi:type="uml:Note" scope="public">
				<model package="EAPK_829B93F1_DBCA_48a9_92EA_A8EBE0959E1A" tpos="0" ea_localid="11" ea_eleType="element"/>
				<properties documentation="Realización: RegistrationController + PatientSelfRegistration y VerificationController. Cuenta y ficha se crean en una transacción, sin vincular fichas previas por coincidencia. Asignación de rol es un concepto persistido con Query Builder, no un modelo Eloquent adicional. El correo se solicita tras COMMIT; un fallo no elimina la cuenta. El registro no reserva citas." isSpecification="false" sType="Note" nType="0" alias="cu03-nota" scope="public"/>
				<project author="llx21" version="1.0" phase="1.0" created="2026-10-24 19:53:04" modified="2026-10-24 19:53:04" complexity="1" status="Proposed"/>
				<code gentype="&lt;none&gt;"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>
				<xrefs/>
				<extendedProperties tagged="0" package_name="CU-03 Registrarse como paciente"/>
			</element>
			<element xmi:idref="EAPK_BB8F66C3_F637_467c_BE35_95E99AB37359" xmi:type="uml:Package" name="CU-04 Registrar y gestionar pacientes en recepción" scope="public">
				<model package2="EAID_BB8F66C3_F637_467c_BE35_95E99AB37359" package="EAPK_63ADD16C_08C6_44f5_9AFD_845E65392280" tpos="0" ea_localid="4" ea_eleType="package"/>
				<properties documentation="Sesión vigente y permiso efectivo pacientes.gestionar.&#xA;Realización: PacienteController + PatientRegistration; entidad: Paciente. La versión de edición es un HMAC calculado, no otra columna. Alta y edición son transaccionales; edición bloquea ficha y comprueba versión. CI normalizado único incluso entre inactivos. Cambiar estado conserva código, cuenta e historial. No hay borrado físico ni creación de historia clínica." isSpecification="false" sType="Package" nType="0" scope="public"/>
				<project author="llx21" phase="1.0" created="2026-10-24 19:53:01" modified="2026-10-24 19:53:01" complexity="1" status="Proposed"/>
				<code gentype="Java"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>
				<xrefs/>

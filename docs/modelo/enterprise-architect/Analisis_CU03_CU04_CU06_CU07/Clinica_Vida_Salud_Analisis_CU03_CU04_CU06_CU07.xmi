			<packagedElement xmi:type="uml:Package" xmi:id="EAPK_BB8F66C3_F637_467c_BE35_95E99AB37359" name="CU-04 Registrar y gestionar pacientes en recepción" visibility="public">
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_07D84087_E236_471d_AD38_D434A8D020D3" body="Realización: PacienteController + PatientRegistration; entidad: Paciente. La versión de edición es un HMAC calculado, no otra columna. Alta y edición son transaccionales; edición bloquea ficha y comprueba versión. CI normalizado único incluso entre inactivos. Cambiar estado conserva código, cuenta e historial. No hay borrado físico ni creación de historia clínica."/>
				<packagedElement xmi:type="uml:Actor" xmi:id="EAID_13AE7020_03BD_4374_A75E_6525C3705888" name="Recepción / Gestor autorizado" visibility="public"/>

			<element xmi:idref="EAPK_829B93F1_DBCA_48a9_92EA_A8EBE0959E1A" xmi:type="uml:Package" name="CU-03 Registrarse como paciente" scope="public">
				<model package2="EAID_829B93F1_DBCA_48a9_92EA_A8EBE0959E1A" package="EAPK_63ADD16C_08C6_44f5_9AFD_845E65392280" tpos="0" ea_localid="3" ea_eleType="package"/>
				<properties documentation="Registro público; verificar correo exige sesión de la misma cuenta y enlace firmado vigente.&#xA;Realización: RegistrationController + PatientSelfRegistration y VerificationController. Cuenta y ficha se crean en una transacción, sin vincular fichas previas por coincidencia. Asignación de rol es un concepto persistido con Query Builder, no un modelo Eloquent adicional. El correo se solicita tras COMMIT; un fallo no elimina la cuenta. El registro no reserva citas." isSpecification="false" sType="Package" nType="0" scope="public"/>
				<project author="llx21" phase="1.0" created="2026-10-24 19:53:01" modified="2026-10-24 19:53:01" complexity="1" status="Proposed"/>

  "cases": [
    {
      "id": "CU-03",
      "title": "Registrarse como paciente",
      "permission": "Registro público; verificar correo exige sesión de la misma cuenta y enlace firmado vigente.",
      "rules": "Realización: RegistrationController + PatientSelfRegistration y VerificationController. Cuenta y ficha se crean en una transacción, sin vincular fichas previas por coincidencia. Asignación de rol es un concepto persistido con Query Builder, no un modelo Eloquent adicional. El correo se solicita tras COMMIT; un fallo no elimina la cuenta. El registro no reserva citas.",
      "sources": [
        "docs/casos-de-uso/CU-03/especificacion.md",
        "sistema/backend/app/Services/Pacientes/PatientSelfRegistration.php",
        "sistema/backend/app/Http/Controllers/Pacientes/RegistrationController.php",
        "sistema/backend/app/Http/Controllers/Auth/VerificationController.php"
      ]
    },
    {
      "id": "CU-04",
      "title": "Registrar y gestionar pacientes en recepción",
      "permission": "Sesión vigente y permiso efectivo pacientes.gestionar.",
      "rules": "Realización: PacienteController + PatientRegistration; entidad: Paciente. La versión de edición es un HMAC calculado, no otra columna. Alta y edición son transaccionales; edición bloquea ficha y comprueba versión. CI normalizado único incluso entre inactivos. Cambiar estado conserva código, cuenta e historial. No hay borrado físico ni creación de historia clínica.",
      "sources": [
        "docs/casos-de-uso/CU-04/especificacion.md",
        "sistema/backend/app/Http/Controllers/Pacientes/PacienteController.php",
        "sistema/backend/app/Services/Pacientes/PatientRegistration.php",
        "sistema/backend/app/Models/Paciente.php"
      ]
    },
    {
      "id": "CU-06",
      "title": "Configurar horarios de atención y bloqueos",
      "permission": "Sesión vigente y permiso efectivo horarios.gestionar.",
      "rules": "Realización: HorarioController e IndisponibilidadController + ScheduleManagement. Médico, HorarioAtencion, IndisponibilidadMedico y CitaMedica son entidades existentes. Franja, vigencia y periodo resumen sus campos temporales; no son columnas nuevas. Las operaciones expresan responsabilidades de análisis, realizadas también por servicios. Bloquear primero médico; validar versión, cruces y cobertura de citas. CU-06 no cancela ni reprograma.",
      "sources": [
        "sistema/backend/app/Http/Controllers/Horarios/HorarioController.php",
        "sistema/backend/app/Http/Controllers/Horarios/IndisponibilidadController.php",
        "sistema/backend/app/Services/Horarios/ScheduleManagement.php",
        "sistema/backend/app/Models/HorarioAtencion.php",
        "sistema/backend/app/Models/IndisponibilidadMedico.php"
      ]
    },
    {
      "id": "CU-07",
      "title": "Consultar disponibilidad y reservar cita",
      "permission": "citas.propias: ficha propia activa y correo verificado. citas.gestionar: paciente activo seleccionado.",
      "rules": "Realización del control: CitaController + AppointmentAvailability + AppointmentBooking. Agenda médica agrupa Medico, Especialidad, HorarioAtencion, IndisponibilidadMedico y citas: concepto de análisis, no un modelo Eloquent nuevo. Registro de cambio representa cambios_cita (Query Builder). Revisar no aparta turno. Token cifrado ligado al actor, 30 min; reserva bloquea médico y paciente, revalida y guarda cita programada + auditoría de forma atómica. Reintento devuelve la misma cita. Comprobante solo para titular o gestor.",
      "sources": [
        "sistema/backend/app/Http/Controllers/Citas/CitaController.php",
        "sistema/backend/app/Services/Citas/AppointmentAvailability.php",
        "sistema/backend/app/Services/Citas/AppointmentBooking.php",
        "sistema/backend/app/Models/CitaMedica.php"
      ]
    }
  ],

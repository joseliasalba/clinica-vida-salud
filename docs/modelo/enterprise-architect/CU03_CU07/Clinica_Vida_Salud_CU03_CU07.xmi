	<xmi:Documentation exporter="Enterprise Architect" exporterVersion="6.5"/>
	<uml:Model xmi:type="uml:Model" name="EA_Model" visibility="public">
		<packagedElement xmi:type="uml:Package" xmi:id="EAPK_3E9605C5_41C7_42d8_BE97_C16D6825E2E9" name="Clínica Vida Salud - CU-03 a CU-07" visibility="public">
			<packagedElement xmi:type="uml:Package" xmi:id="EAPK_9CE9A6C7_52F1_4a8a_82F0_1AFDDFD22A83" name="CU-03 Registrarse como paciente" visibility="public">
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_C42864AB_B8E1_4621_A047_D5041E892DBD" body="El enlace se recibe fuera del portal. En modo log no se entrega a la bandeja. Crear la cuenta o reenviar no verifica el correo automáticamente."/>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_44048E3E_4AD6_461d_B153_00EFBBFF691B" body="Datos inválidos o duplicados: rechazar sin registros parciales. Error de correo: conservar la cuenta e informar reenvío. Firma, correo, cuenta o vigencia incorrectos: rechazar la verificación."/>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_3C137352_9C8E_435e_A6CB_B4F5999CA1D7" body="El control agrupa RegistrationController, VerificationController y PatientSelfRegistration. El correo es una notificación externa; su fallo no deshace la cuenta creada."/>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_224F538C_6921_4c2d_8D0D_D6976FF5CC86" body="Registro público. Verificación: cuenta autenticada, firma vigente y correo de la misma cuenta.&#xA;&#xA;Cuenta y ficha se crean juntas. Solo rol paciente. No vincular fichas previas por coincidencia de CI o correo. Registrar una cuenta no reserva una cita."/>
				<packagedElement xmi:type="uml:Collaboration" xmi:id="EAID_CB000000_6C7_52F1_4a8a_82F0_1AFDDFD22A8" name="EA_Collaboration1" visibility="public">

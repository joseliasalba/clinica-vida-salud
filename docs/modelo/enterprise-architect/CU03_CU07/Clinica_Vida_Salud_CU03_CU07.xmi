				<model package="EAPK_16176056_8557_4353_94CF_F91C7AD80D6F" tpos="0" ea_localid="141" ea_eleType="element"/>
				<properties documentation="Recepción puede reservar a pacientes sin cuenta y no exige verificación de su correo. Un paciente solo reserva su ficha vinculada. La consulta del comprobante exige propiedad o permiso de gestión." isSpecification="false" sType="Note" nType="0" alias="cu07-nav-nota" scope="public"/>

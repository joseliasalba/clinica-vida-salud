			<element xmi:idref="EAID_CFEE414C_1D7A_42fb_9B7A_E1B67A58F201" xmi:type="uml:Note" scope="public">
				<model package="EAPK_8A6D329D_71C8_4f91_811A_2420509ACF79" tpos="0" ea_localid="119" ea_eleType="element"/>
				<properties documentation="Al editar un horario usado por citas se conservan día, horas, duración y fecha inicial. La fecha final y el estado respetan las citas pendientes. Horas de Bolivia e intervalos [inicio, fin)." isSpecification="false" sType="Note" nType="0" alias="cu06-seq-nota" scope="public"/>
				<project author="llx21" version="1.0" phase="1.0" created="2026-10-23 19:27:49" modified="2026-10-23 19:27:49" complexity="1" status="Proposed"/>

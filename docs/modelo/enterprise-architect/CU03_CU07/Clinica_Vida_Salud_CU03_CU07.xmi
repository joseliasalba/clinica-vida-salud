			<element xmi:idref="EAID_44048E3E_4AD6_461d_B153_00EFBBFF691B" xmi:type="uml:Note" scope="public">
				<model package="EAPK_9CE9A6C7_52F1_4a8a_82F0_1AFDDFD22A83" tpos="0" ea_localid="31" ea_eleType="element"/>
				<properties documentation="Datos inválidos o duplicados: rechazar sin registros parciales. Error de correo: conservar la cuenta e informar reenvío. Firma, correo, cuenta o vigencia incorrectos: rechazar la verificación." isSpecification="false" sType="Note" nType="0" alias="cu03-seq-nota" scope="public"/>

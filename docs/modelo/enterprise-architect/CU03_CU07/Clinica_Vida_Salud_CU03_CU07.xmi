			<element xmi:idref="EAID_0C501C90_6605_4327_BE0F_DC39B64D4D98" xmi:type="uml:Note" scope="public">
				<model package="EAPK_16176056_8557_4353_94CF_F91C7AD80D6F" tpos="0" ea_localid="125" ea_eleType="element"/>
				<properties documentation="citas.propias: ficha propia activa y correo verificado. citas.gestionar: paciente activo seleccionado.&#xA;&#xA;Reserva hasta 30 días adelante. Revisar no aparta el turno. Revalidar al guardar. Estado inicial programada. Token ligado al actor, 30 minutos; reintento devuelve la misma cita." isSpecification="false" sType="Note" nType="0" alias="cu07-reglas" scope="public"/>
				<project author="llx21" version="1.0" phase="1.0" created="2026-10-23 19:27:49" modified="2026-10-23 19:27:49" complexity="1" status="Proposed"/>
				<code gentype="&lt;none&gt;"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>
				<xrefs/>
				<extendedProperties tagged="0" package_name="CU-07 Consultar disponibilidad y reservar cita"/>
			</element>
			<element xmi:idref="EAID_121D718C_B491_402b_A7E3_12134A8ADCA2" xmi:type="uml:Note" scope="public">
				<model package="EAPK_16176056_8557_4353_94CF_F91C7AD80D6F" tpos="0" ea_localid="148" ea_eleType="element"/>
				<properties documentation="Token ya usado: devolver la misma cita sin insertar otra auditoría. Si el turno se ocupa, expira la revisión o hay cruce: no guardar y volver a consultar. Estado programada no equivale a CU-10 confirmada." isSpecification="false" sType="Note" nType="0" alias="cu07-seq-nota" scope="public"/>
				<project author="llx21" version="1.0" phase="1.0" created="2026-10-23 19:27:50" modified="2026-10-23 19:27:50" complexity="1" status="Proposed"/>
				<code gentype="&lt;none&gt;"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>
				<xrefs/>
				<extendedProperties tagged="0" package_name="CU-07 Consultar disponibilidad y reservar cita"/>
			</element>
			<element xmi:idref="EAID_4883C418_E106_45b1_9ED1_D52622AEF41E" xmi:type="uml:Note" scope="public">
				<model package="EAPK_16176056_8557_4353_94CF_F91C7AD80D6F" tpos="0" ea_localid="133" ea_eleType="element"/>
				<properties documentation="Servicios: AppointmentAvailability y AppointmentBooking. PostgreSQL impide cruces del mismo médico y paciente. Un reenvío del mismo token devuelve un solo comprobante." isSpecification="false" sType="Note" nType="0" alias="cu07-com-nota" scope="public"/>
				<project author="llx21" version="1.0" phase="1.0" created="2026-10-23 19:27:50" modified="2026-10-23 19:27:50" complexity="1" status="Proposed"/>

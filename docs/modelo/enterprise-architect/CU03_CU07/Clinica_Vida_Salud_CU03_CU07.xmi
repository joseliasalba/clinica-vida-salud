			<element xmi:idref="EAPK_4D3275D6_DD3C_4e59_B2FA_EBF065A75778" xmi:type="uml:Package" name="CU-04 Registrar y gestionar pacientes en recepción" scope="public">
				<model package2="EAID_4D3275D6_DD3C_4e59_B2FA_EBF065A75778" package="EAPK_3E9605C5_41C7_42d8_BE97_C16D6825E2E9" tpos="0" ea_localid="4" ea_eleType="package"/>
				<properties documentation="Sesión vigente y permiso efectivo pacientes.gestionar.\r\nCI opcional, normalizado y único incluso entre inactivos. Código PAC-ID inmutable. No borrar fichas ni modificar la cuenta de acceso al cambiar su estado." isSpecification="false" sType="Package" nType="0" scope="public"/>
				<project author="llx21" phase="1.0" created="2026-10-23 19:27:47" modified="2026-10-23 19:27:47" complexity="1" status="Proposed"/>
				<code gentype="Java"/>

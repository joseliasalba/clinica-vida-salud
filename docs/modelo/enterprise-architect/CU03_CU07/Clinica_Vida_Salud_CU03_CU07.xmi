			<packagedElement xmi:type="uml:Package" xmi:id="EAPK_16176056_8557_4353_94CF_F91C7AD80D6F" name="CU-07 Consultar disponibilidad y reservar cita" visibility="public">
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_55D3C028_78CD_4d79_9891_56B324529816" body="Recepción puede reservar a pacientes sin cuenta y no exige verificación de su correo. Un paciente solo reserva su ficha vinculada. La consulta del comprobante exige propiedad o permiso de gestión."/>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_4883C418_E106_45b1_9ED1_D52622AEF41E" body="Servicios: AppointmentAvailability y AppointmentBooking. PostgreSQL impide cruces del mismo médico y paciente. Un reenvío del mismo token devuelve un solo comprobante."/>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_121D718C_B491_402b_A7E3_12134A8ADCA2" body="Token ya usado: devolver la misma cita sin insertar otra auditoría. Si el turno se ocupa, expira la revisión o hay cruce: no guardar y volver a consultar. Estado programada no equivale a CU-10 confirmada."/>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_0C501C90_6605_4327_BE0F_DC39B64D4D98" body="citas.propias: ficha propia activa y correo verificado. citas.gestionar: paciente activo seleccionado.&#xA;&#xA;Reserva hasta 30 días adelante. Revisar no aparta el turno. Revalidar al guardar. Estado inicial programada. Token ligado al actor, 30 minutos; reintento devuelve la misma cita."/>
				<packagedElement xmi:type="uml:Collaboration" xmi:id="EAID_CB000000_056_8557_4353_94CF_F91C7AD80D6" name="EA_Collaboration5" visibility="public">
					<ownedBehavior xmi:type="uml:Interaction" xmi:id="EAID_IN000000_056_8557_4353_94CF_F91C7AD80D6" name="EA_Interaction5" visibility="public">
						<lifeline xmi:type="uml:Lifeline" xmi:id="EAID_LL000000_329E_4f39_88E4_2B0C415610BC" name="Paciente / Recepción" visibility="public" represents="EAID_AT000000_000_329E_4f39_88E4_2B0C415610B"/>
						<lifeline xmi:type="uml:Lifeline" xmi:id="EAID_LL000000_C66C_4b5b_8712_ECD2F8EC7C71" name="AppointmentAvailability" visibility="public" represents="EAID_AT000000_000_C66C_4b5b_8712_ECD2F8EC7C7"/>
						<lifeline xmi:type="uml:Lifeline" xmi:id="EAID_LL000000_A2B5_4804_BEEA_8F7862A8275F" name="AppointmentBooking" visibility="public" represents="EAID_AT000000_000_A2B5_4804_BEEA_8F7862A8275"/>
						<lifeline xmi:type="uml:Lifeline" xmi:id="EAID_LL000000_A0C6_49cd_8BDB_9556969236C2" name="CitaController" visibility="public" represents="EAID_AT000000_000_A0C6_49cd_8BDB_9556969236C"/>
						<lifeline xmi:type="uml:Lifeline" xmi:id="EAID_LL000000_AECB_4605_8A3C_98DFAF5AF1E4" name="Modelos / PostgreSQL" visibility="public" represents="EAID_AT000000_000_AECB_4605_8A3C_98DFAF5AF1E"/>

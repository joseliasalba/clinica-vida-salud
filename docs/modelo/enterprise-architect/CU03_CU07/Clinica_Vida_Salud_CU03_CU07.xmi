			<element xmi:idref="EAID_C42864AB_B8E1_4621_A047_D5041E892DBD" xmi:type="uml:Note" scope="public">
				<model package="EAPK_9CE9A6C7_52F1_4a8a_82F0_1AFDDFD22A83" tpos="0" ea_localid="24" ea_eleType="element"/>
				<properties documentation="El enlace se recibe fuera del portal. En modo log no se entrega a la bandeja. Crear la cuenta o reenviar no verifica el correo automáticamente." isSpecification="false" sType="Note" nType="0" alias="cu03-nav-nota" scope="public"/>
				<project author="llx21" version="1.0" phase="1.0" created="2026-10-23 19:27:48" modified="2026-10-23 19:27:48" complexity="1" status="Proposed"/>

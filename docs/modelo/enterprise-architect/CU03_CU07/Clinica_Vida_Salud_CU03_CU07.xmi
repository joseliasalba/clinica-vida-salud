				<model package="EAPK_8A6D329D_71C8_4f91_811A_2420509ACF79" tpos="0" ea_localid="105" ea_eleType="element"/>
				<properties documentation="Los bloqueos restan disponibilidad sin borrar el horario semanal. Horarios y bloqueos activos no se solapan entre sí dentro de su tipo. Se conservan citas y relaciones." isSpecification="false" sType="Note" nType="0" alias="cu06-com-nota" scope="public"/>

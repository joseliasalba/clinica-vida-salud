			<element xmi:idref="EAID_A9A292A8_5BCC_41bb_923A_C23BF3ECCB24" xmi:type="uml:Note" scope="public">
				<model package="EAPK_8A6D329D_71C8_4f91_811A_2420509ACF79" tpos="0" ea_localid="96" ea_eleType="element"/>
				<properties documentation="Sesión vigente y permiso efectivo horarios.gestionar.&#xA;&#xA;Días 1 a 7; duración divide la franja en turnos completos. Vigencia con ocurrencias reales. Bloquear siempre primero el médico. No dejar citas pendientes sin cobertura ni bloquear citas pendientes." isSpecification="false" sType="Note" nType="0" alias="cu06-reglas" scope="public"/>
				<project author="llx21" version="1.0" phase="1.0" created="2026-10-23 19:27:49" modified="2026-10-23 19:27:49" complexity="1" status="Proposed"/>

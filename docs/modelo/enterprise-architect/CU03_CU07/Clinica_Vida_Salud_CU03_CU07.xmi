			<element xmi:idref="EAID_3C137352_9C8E_435e_A6CB_B4F5999CA1D7" xmi:type="uml:Note" scope="public">
				<model package="EAPK_9CE9A6C7_52F1_4a8a_82F0_1AFDDFD22A83" tpos="0" ea_localid="16" ea_eleType="element"/>
				<properties documentation="El control agrupa RegistrationController, VerificationController y PatientSelfRegistration. El correo es una notificación externa; su fallo no deshace la cuenta creada." isSpecification="false" sType="Note" nType="0" alias="cu03-com-nota" scope="public"/>
				<project author="llx21" version="1.0" phase="1.0" created="2026-10-23 19:27:48" modified="2026-10-23 19:27:48" complexity="1" status="Proposed"/>

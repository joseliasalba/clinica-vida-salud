			<packagedElement xmi:type="uml:Package" xmi:id="EAPK_CA0957ED_6A50_473e_AC30_A356E2439CA5" name="CU-05 Gestionar médicos y especialidades" visibility="public">
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_A37AF4CE_1D8A_4c9c_8848_B5A10B32A87B" body="Las rutas GET muestran formularios y confirmaciones; no alteran datos. Las altas y ediciones no cambian el estado; se usa PATCH desde su confirmación."/>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_254E3F62_0F41_4f5b_934C_2D0A0110D811" body="Duplicado o versión antigua: rechazar. Una cuenta vinculada se selecciona explícitamente. Reactivar médico exige especialidad activa. Desactivar conserva horarios y citas."/>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_1FD745B7_B50D_4e55_92A5_9B9EEC001B3A" body="Sesión vigente y permiso efectivo medicos.gestionar.&#xA;&#xA;Especialidades activas obligatorias. Cuenta existente opcional, elegible y sin otra vinculación. Registro profesional y nombre de especialidad únicos normalizados. Conservar relaciones e identidad."/>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_1D3A978A_BE5B_4b78_BEE9_16274CC05D30" body="Servicios: DoctorManagement y SpecialtyManagement. Vincular una cuenta existente no crea usuarios ni cambia roles. El estado se confirma en una página separada."/>
				<packagedElement xmi:type="uml:Collaboration" xmi:id="EAID_CB000000_7ED_6A50_473e_AC30_A356E2439CA" name="EA_Collaboration3" visibility="public">

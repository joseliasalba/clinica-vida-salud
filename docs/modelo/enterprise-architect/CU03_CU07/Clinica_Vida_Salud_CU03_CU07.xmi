			<element xmi:idref="EAID_224F538C_6921_4c2d_8D0D_D6976FF5CC86" xmi:type="uml:Note" scope="public">
				<model package="EAPK_9CE9A6C7_52F1_4a8a_82F0_1AFDDFD22A83" tpos="0" ea_localid="8" ea_eleType="element"/>
				<properties documentation="Registro público. Verificación: cuenta autenticada, firma vigente y correo de la misma cuenta.&#xA;&#xA;Cuenta y ficha se crean juntas. Solo rol paciente. No vincular fichas previas por coincidencia de CI o correo. Registrar una cuenta no reserva una cita." isSpecification="false" sType="Note" nType="0" alias="cu03-reglas" scope="public"/>
				<project author="llx21" version="1.0" phase="1.0" created="2026-10-23 19:27:48" modified="2026-10-23 19:27:48" complexity="1" status="Proposed"/>

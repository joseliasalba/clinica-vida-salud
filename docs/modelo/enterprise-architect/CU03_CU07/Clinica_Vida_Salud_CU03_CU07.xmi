			<element xmi:idref="EAPK_16176056_8557_4353_94CF_F91C7AD80D6F" xmi:type="uml:Package" name="CU-07 Consultar disponibilidad y reservar cita" scope="public">
				<model package2="EAID_16176056_8557_4353_94CF_F91C7AD80D6F" package="EAPK_3E9605C5_41C7_42d8_BE97_C16D6825E2E9" tpos="0" ea_localid="7" ea_eleType="package"/>
				<properties documentation="citas.propias: ficha propia activa y correo verificado. citas.gestionar: paciente activo seleccionado.\r\nReserva hasta 30 días adelante. Revisar no aparta el turno. Revalidar al guardar. Estado inicial programada. Token ligado al actor, 30 minutos; reintento devuelve la misma cita." isSpecification="false" sType="Package" nType="0" scope="public"/>

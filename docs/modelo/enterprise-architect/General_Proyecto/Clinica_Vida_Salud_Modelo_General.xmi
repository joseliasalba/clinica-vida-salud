			<packagedElement xmi:type="uml:Package" xmi:id="EAPK_10B8D460_924B_4711_87E6_C1E87CB51327" name="01 Captura de requisitos" visibility="public">
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_FC4BFB8D_608F_4dcd_B6E5_AA79FC88016F" body="Responsabilidad: Identificar pacientes y registrar o gestionar citas de acuerdo con su autorización&#xA;&#xA;Límite de acceso: No configura médicos ni horarios con el conjunto inicial de permisos">
					<annotatedElement xmi:idref="EAID_D76B21AC_CF87_4aa3_99E2_A2C06053D182"/>
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_F903440C_DA99_4767_9120_77ABCB5AD23B" body="&lt;p&gt;&lt;b&gt;Responsabilidad:&lt;/b&gt; Configurar usuarios, médicos, especialidades y horarios; supervisar operaciones autorizadas&lt;/p&gt;&lt;p&gt;&lt;b&gt;Límite de acceso:&lt;/b&gt; Actúa según permisos efectivos; no se presume acceso irrestricto a datos clínicos&lt;/p&gt;">
					<annotatedElement xmi:idref="EAID_97678C5B_3D33_4bce_ABD7_94D51DF5E328"/>
				</ownedComment>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_F2A6C66C_1EC5_4f8a_9C95_77328A17C239" body="Responsabilidad: Acceder a su cuenta, verificar correo y reservar para su ficha vinculada&#xA;&#xA;Límite de acceso: No puede escoger la identidad de otro paciente ni consultar comprobantes ajenos">
					<annotatedElement xmi:idref="EAID_10DD7C9D_3BE9_4d62_BC92_C1947D57DCBA"/>

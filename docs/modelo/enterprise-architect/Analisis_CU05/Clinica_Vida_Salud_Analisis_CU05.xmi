			<element xmi:idref="EAID_6BA7FF23_2C88_4b08_87C1_207EE20C1E85" xmi:type="uml:Class" name="V.Médicos y especialidades" scope="public">
				<model package="EAPK_0B70787D_A839_4a0f_AD99_8BAAA259EDDB" tpos="0" ea_localid="3" ea_eleType="element"/>
				<properties documentation="Clases conceptuales de análisis, no nuevas clases PHP. La frontera agrupa las vistas de médicos y especialidades. El control se realiza con MedicoController, EspecialidadController, Form Requests, DoctorManagement y SpecialtyManagement. Asignación de especialidad representa el pivote medico_especialidad operado con Query Builder; no se afirma la existencia de un modelo Eloquent específico. Médico-Cuenta es un vínculo opcional y único en ambos extremos; no crea cuentas. Guardado transaccional, unicidad normalizada, firma de edición y desactivación sin borrado. El alta y la reactivación de médico comprueban especialidades activas. No se dibujan notas explicativas." isSpecification="false" sType="Class" nType="0" alias="vista" scope="public" stereotype="boundary" isRoot="false" isLeaf="false" isAbstract="false" isActive="false"/>
				<project author="llx21" version="1.0" phase="1.0" created="2026-10-24 21:27:55" modified="2026-10-24 21:27:55" complexity="1" status="Proposed"/>
				<code gentype="Java"/>

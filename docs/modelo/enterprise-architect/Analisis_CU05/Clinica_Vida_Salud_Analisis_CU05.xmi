		<diagrams>
			<diagram xmi:id="EAID_42909C0F_DF17_4443_AF0D_64851028E400">
				<model package="EAPK_0B70787D_A839_4a0f_AD99_8BAAA259EDDB" localID="1" owner="EAPK_0B70787D_A839_4a0f_AD99_8BAAA259EDDB" tpos="0"/>
				<properties name="CU-05 Diagrama de clases de análisis" type="Logical" documentation="Clases conceptuales de análisis, no nuevas clases PHP. La frontera agrupa las vistas de médicos y especialidades. El control se realiza con MedicoController, EspecialidadController, Form Requests, DoctorManagement y SpecialtyManagement. Asignación de especialidad representa el pivote medico_especialidad operado con Query Builder; no se afirma la existencia de un modelo Eloquent específico. Médico-Cuenta es un vínculo opcional y único en ambos extremos; no crea cuentas. Guardado transaccional, unicidad normalizada, firma de edición y desactivación sin borrado. El alta y la reactivación de médico comprueban especialidades activas. No se dibujan notas explicativas.&#xA;Sesión vigente y permiso efectivo medicos.gestionar."/>
				<project version="1" created="2026-10-24 21:28:02" modified="2026-10-24 21:28:02"/>

			<element xmi:idref="EAID_943DD4CC_F652_4d8a_A988_CF5D1371D12C" xmi:type="uml:InteractionFragment" name="[rol o permiso del catálogo]" scope="public">
				<model package="EAPK_8A72913F_D83C_46aa_948F_F4A1D25F6400" tpos="0" ea_localid="59" ea_eleType="element"/>
				<properties isSpecification="false" sType="InteractionFragment" nType="1" alias="cu02-frag-2" scope="public" isRoot="false" isLeaf="false" isAbstract="false"/>
				<project author="llx21" version="1.0" phase="1.0" created="2026-10-24 17:39:05" modified="2026-10-24 17:40:10" complexity="1" status="Proposed"/>
				<code gentype="&lt;none&gt;"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=3;"/>

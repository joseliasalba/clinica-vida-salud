						<lifeline xmi:type="uml:Lifeline" xmi:id="EAID_LL000000_03BE_45ba_B565_ADBA47C36B29" name="UserAdministration" visibility="public" represents="EAID_AT000000_000_03BE_45ba_B565_ADBA47C36B2"/>
						<lifeline xmi:type="uml:Lifeline" xmi:id="EAID_LL000000_AE37_44c2_A362_2837C50B21B3" name="UserController / RoleController /&#xA;PermissionController" visibility="public" represents="EAID_AT000000_000_AE37_44c2_A362_2837C50B21B"/>

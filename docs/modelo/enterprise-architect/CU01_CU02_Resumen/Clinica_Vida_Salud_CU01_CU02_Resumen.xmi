				<packagedElement xmi:type="uml:Class" xmi:id="EAID_5FA0FDD5_BF63_4962_B60B_AA14F01E7006" name="Clínica Vida Salud" visibility="public"/>
			</packagedElement>
			<packagedElement xmi:type="uml:Package" xmi:id="EAPK_8A72913F_D83C_46aa_948F_F4A1D25F6400" name="CU-02 Administrar usuarios, roles y permisos" visibility="public">
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_96E62CF0_765C_4f27_B864_86CBBB43D452" body="Sesión vigente y permiso efectivo usuarios.gestionar. Cada mutación vuelve a comprobar autorización dentro de la transacción.&#xA;&#xA;Usuarios con varios roles y roles con varios permisos. Conservar vínculos retirados como inactivos. No borrar físicamente ni crear personas clínicas automáticamente. Proteger la propia administración y conservar al menos un gestor efectivo."/>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_55684913_8FBA_4213_89E4_4EC921C14D7B" body="UserAdministration centraliza saveUser(), saveRole() y setPermissionState(). Roles y permisos usan Query Builder; no se inventan modelos Eloquent separados. Los cambios se auditan después de COMMIT, sin contraseñas ni tokens."/>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_3B722544_D093_4c00_9A2A_5F22DDB9E372" body="Duplicado, selección inválida o retirada de administración: ROLLBACK sin cambios parciales. Contraseña vacía en edición conserva hash; cambio de clave o desactivación rota token. Cambiar correo limpia verificación. Clave/correo/estado pueden revocar enlaces de recuperación. No enviar correo al crear una cuenta desde CU-02."/>
				<ownedComment xmi:type="uml:Comment" xmi:id="EAID_047E7E6B_4994_49c8_9576_92CE99C3ACC0" body="Estado de usuario y rol: en su formulario de edición, sin ruta independiente. Permisos: cambio con PATCH. Todas las acciones de escritura requieren CSRF. Sin sesión: login; sin permiso: 403. Cancelar no guarda. El catálogo funcional no admite códigos arbitrarios."/>
				<packagedElement xmi:type="uml:Collaboration" xmi:id="EAID_CB000000_13F_D83C_46aa_948F_F4A1D25F640" name="EA_Collaboration2" visibility="public">
					<ownedBehavior xmi:type="uml:Interaction" xmi:id="EAID_IN000000_13F_D83C_46aa_948F_F4A1D25F640" name="EA_Interaction2" visibility="public">

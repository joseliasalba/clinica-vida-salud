			<element xmi:idref="EAID_A4DC2021_16BB_44f8_9CAD_464BD464DB8E" xmi:type="uml:Note" scope="public">
				<model package="EAPK_D23B71D6_316F_47b2_837C_02DFC0D2188C" tpos="0" ea_localid="5" ea_eleType="element"/>
				<properties documentation="Acceso público para invitados. Rutas internas: sesión vigente, cuenta activa y permisos efectivos.&#xA;&#xA;Acceso por usuario o correo y contraseña sin normalizar. Cinco fallos por identificador/IP: espera de 15 minutos; límite adicional por IP. Inactividad: 30 minutos. Autorización comprobada en servidor. Sin recordar sesión." isSpecification="false" sType="Note" nType="0" alias="cu01-reglas" scope="public"/>
				<project author="llx21" version="1.0" phase="1.0" created="2026-10-24 17:39:04" modified="2026-10-24 17:39:04" complexity="1" status="Proposed"/>
				<code gentype="&lt;none&gt;"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>
				<xrefs/>
				<extendedProperties tagged="0" package_name="CU-01 Iniciar y cerrar sesión"/>
			</element>
			<element xmi:idref="EAPK_8A72913F_D83C_46aa_948F_F4A1D25F6400" xmi:type="uml:Package" name="CU-02 Administrar usuarios, roles y permisos" scope="public">
				<model package2="EAID_8A72913F_D83C_46aa_948F_F4A1D25F6400" package="EAPK_F25931EE_7DC7_4e35_8EA4_BCE2C3BCED82" tpos="0" ea_localid="4" ea_eleType="package"/>
				<properties documentation="Sesión vigente y permiso efectivo usuarios.gestionar. Cada mutación vuelve a comprobar autorización dentro de la transacción.&#xA;Usuarios con varios roles y roles con varios permisos. Conservar vínculos retirados como inactivos. No borrar físicamente ni crear personas clínicas automáticamente. Proteger la propia administración y conservar al menos un gestor efectivo." isSpecification="false" sType="Package" nType="0" scope="public"/>
				<project author="llx21" phase="1.0" created="2026-10-24 17:39:03" modified="2026-10-24 17:39:03" complexity="1" status="Proposed"/>
				<code gentype="Java"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>

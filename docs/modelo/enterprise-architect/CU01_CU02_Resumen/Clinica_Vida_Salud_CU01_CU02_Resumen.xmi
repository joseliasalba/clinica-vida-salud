			<element xmi:idref="EAID_10CBA71E_B4F8_4f5e_A953_31515B5930B7" xmi:type="uml:Note" scope="public">
				<model package="EAPK_D23B71D6_316F_47b2_837C_02DFC0D2188C" tpos="0" ea_localid="21" ea_eleType="element"/>
				<properties documentation="Sin sesión vigente: volver al acceso; sin permiso: 403. La recuperación se referencia como CU-01.1, fuera de estos ocho diagramas. Desde el acceso normal se va a /inicio; si existe booking.continue se continúa en /citas. No se aceptan URLs externas de retorno." isSpecification="false" sType="Note" nType="0" alias="cu01-nav-nota" scope="public"/>
				<project author="llx21" version="1.0" phase="1.0" created="2026-10-24 17:39:04" modified="2026-10-24 17:39:04" complexity="1" status="Proposed"/>
				<code gentype="&lt;none&gt;"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>
				<xrefs/>
				<extendedProperties tagged="0" package_name="CU-01 Iniciar y cerrar sesión"/>
			</element>
			<element xmi:idref="EAID_21B18486_148D_45d8_B5AC_90640AF56022" xmi:type="uml:Note" scope="public">
				<model package="EAPK_D23B71D6_316F_47b2_837C_02DFC0D2188C" tpos="0" ea_localid="27" ea_eleType="element"/>
				<properties documentation="Fallo de credenciales: mensaje genérico y sumar intento. Límite alcanzado: rechazar temporalmente. Cuenta inactiva, hash/token cambiado o inactividad: invalidar sesión y volver al login. Sin permiso: 403. Las contraseñas y tokens no se escriben en los diagramas ni en auditoría." isSpecification="false" sType="Note" nType="0" alias="cu01-seq-nota" scope="public"/>
				<project author="llx21" version="1.0" phase="1.0" created="2026-10-24 17:39:04" modified="2026-10-24 17:39:04" complexity="1" status="Proposed"/>
				<code gentype="&lt;none&gt;"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>
				<xrefs/>
				<extendedProperties tagged="0" package_name="CU-01 Iniciar y cerrar sesión"/>
			</element>
			<element xmi:idref="EAID_38E643F1_4B81_47fd_B952_E2C6591F4434" xmi:type="uml:Note" scope="public">
				<model package="EAPK_D23B71D6_316F_47b2_837C_02DFC0D2188C" tpos="0" ea_localid="13" ea_eleType="element"/>
				<properties documentation="El control agrupa controlador de sesión y middleware. Los permisos se evalúan por cuenta, roles, asignaciones, estado y vigencia. El acceso fallido no distingue cuenta inexistente, inactiva ni clave incorrecta." isSpecification="false" sType="Note" nType="0" alias="cu01-com-nota" scope="public"/>
				<project author="llx21" version="1.0" phase="1.0" created="2026-10-24 17:39:04" modified="2026-10-24 17:39:04" complexity="1" status="Proposed"/>
				<code gentype="&lt;none&gt;"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>
				<xrefs/>
				<extendedProperties tagged="0" package_name="CU-01 Iniciar y cerrar sesión"/>
			</element>
			<element xmi:idref="EAID_5FA0FDD5_BF63_4962_B60B_AA14F01E7006" xmi:type="uml:Boundary" name="Clínica Vida Salud" scope="public">
				<model package="EAPK_D23B71D6_316F_47b2_837C_02DFC0D2188C" tpos="0" ea_localid="4" ea_eleType="element"/>
				<properties isSpecification="false" sType="Boundary" nType="0" alias="cu01-limite" scope="public"/>
				<project author="llx21" version="1.0" phase="1.0" created="2026-10-24 17:39:04" modified="2026-10-24 17:39:04" complexity="1" status="Proposed"/>
				<code gentype="&lt;none&gt;"/>

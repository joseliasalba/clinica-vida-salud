			</element>
			<element xmi:idref="EAID_047E7E6B_4994_49c8_9576_92CE99C3ACC0" xmi:type="uml:Note" scope="public">
				<model package="EAPK_8A72913F_D83C_46aa_948F_F4A1D25F6400" tpos="0" ea_localid="50" ea_eleType="element"/>
				<properties documentation="Estado de usuario y rol: en su formulario de edición, sin ruta independiente. Permisos: cambio con PATCH. Todas las acciones de escritura requieren CSRF. Sin sesión: login; sin permiso: 403. Cancelar no guarda. El catálogo funcional no admite códigos arbitrarios." isSpecification="false" sType="Note" nType="0" alias="cu02-nav-nota" scope="public"/>
				<project author="llx21" version="1.0" phase="1.0" created="2026-10-24 17:39:05" modified="2026-10-24 17:39:05" complexity="1" status="Proposed"/>
				<code gentype="&lt;none&gt;"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>
				<xrefs/>
				<extendedProperties tagged="0" package_name="CU-02 Administrar usuarios, roles y permisos"/>
			</element>
			<element xmi:idref="EAID_3B722544_D093_4c00_9A2A_5F22DDB9E372" xmi:type="uml:Note" scope="public">
				<model package="EAPK_8A72913F_D83C_46aa_948F_F4A1D25F6400" tpos="0" ea_localid="56" ea_eleType="element"/>
				<properties documentation="Duplicado, selección inválida o retirada de administración: ROLLBACK sin cambios parciales. Contraseña vacía en edición conserva hash; cambio de clave o desactivación rota token. Cambiar correo limpia verificación. Clave/correo/estado pueden revocar enlaces de recuperación. No enviar correo al crear una cuenta desde CU-02." isSpecification="false" sType="Note" nType="0" alias="cu02-seq-nota" scope="public"/>
				<project author="llx21" version="1.0" phase="1.0" created="2026-10-24 17:39:05" modified="2026-10-24 17:39:05" complexity="1" status="Proposed"/>
				<code gentype="&lt;none&gt;"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>
				<xrefs/>
				<extendedProperties tagged="0" package_name="CU-02 Administrar usuarios, roles y permisos"/>
			</element>
			<element xmi:idref="EAID_55684913_8FBA_4213_89E4_4EC921C14D7B" xmi:type="uml:Note" scope="public">
				<model package="EAPK_8A72913F_D83C_46aa_948F_F4A1D25F6400" tpos="0" ea_localid="42" ea_eleType="element"/>
				<properties documentation="UserAdministration centraliza saveUser(), saveRole() y setPermissionState(). Roles y permisos usan Query Builder; no se inventan modelos Eloquent separados. Los cambios se auditan después de COMMIT, sin contraseñas ni tokens." isSpecification="false" sType="Note" nType="0" alias="cu02-com-nota" scope="public"/>
				<project author="llx21" version="1.0" phase="1.0" created="2026-10-24 17:39:05" modified="2026-10-24 17:39:05" complexity="1" status="Proposed"/>
				<code gentype="&lt;none&gt;"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>
				<xrefs/>
				<extendedProperties tagged="0" package_name="CU-02 Administrar usuarios, roles y permisos"/>
			</element>
			<element xmi:idref="EAID_96E62CF0_765C_4f27_B864_86CBBB43D452" xmi:type="uml:Note" scope="public">
				<model package="EAPK_8A72913F_D83C_46aa_948F_F4A1D25F6400" tpos="0" ea_localid="33" ea_eleType="element"/>
				<properties documentation="Sesión vigente y permiso efectivo usuarios.gestionar. Cada mutación vuelve a comprobar autorización dentro de la transacción.&#xA;&#xA;Usuarios con varios roles y roles con varios permisos. Conservar vínculos retirados como inactivos. No borrar físicamente ni crear personas clínicas automáticamente. Proteger la propia administración y conservar al menos un gestor efectivo." isSpecification="false" sType="Note" nType="0" alias="cu02-reglas" scope="public"/>
				<project author="llx21" version="1.0" phase="1.0" created="2026-10-24 17:39:05" modified="2026-10-24 17:39:05" complexity="1" status="Proposed"/>
				<code gentype="&lt;none&gt;"/>
				<style appearance="BackColor=-1;BorderColor=-1;BorderWidth=-1;FontColor=-1;VSwimLanes=1;HSwimLanes=1;BorderStyle=0;"/>
				<tags/>
				<xrefs/>
				<extendedProperties tagged="0" package_name="CU-02 Administrar usuarios, roles y permisos"/>
			</element>
